export LC_ALL=C
set -e

. pipestatus

############################################################
summary_format="\
PKGBASE=%{name}\n\
PKGNAME=%{nevr}\n\
PKGPATH=%{vendor}\n\
COMMENT=%{summary}\n\
GROUP=%{group}\n\
MAINTAINER=%{packager}\n\
SIZE_PKG=%{size}\n\
DIST_TAG=%{DistTag}\n\
BUILD_HOST=%{BuildHost}\n\
BUILD_DATE=%{BuildTime:date}\n\
LICENSE=%{license}\n\
SRPM=%{SourceRPM}\n\
URL=%{url}\n\
MACHINE_ARCH=%{arch}\n\
AUTOMATIC=%{autoinstalled}\n\
DESCRIPTION=%{description}\n\
[PROVIDES=%{provides}\n]\
[REQUIRES=%{requires}\n]\
[PLIST=%{filenames}\n]\
"

rpm_format="\
Name=%{name}\n\
Version=%{version}\n\
Release=%{release}\n\
DistTag=%{disttag}\n\
Architecture=%{arch}\n\
Install_Date=%{installtime}\n\
Group=%{group}\n\
Size=%{size}\n\
License=%{license}\n\
Signature=%{filesignatures}\n\
Source_RPM=%{sourcerpm}\n\
Build_Date=%{BuildTime:date}\n\
Build_Host=%{BuildHost}\n\
Packager=%{packager}\n\
Vendor=%{vendor}\n\
Url=%{url}\n\
Summary=%{summary}\n\
Description=%{description}\n\
Filenames=[%{filenames}\n]\
"
#DIST_TAG=%{DistTag}\n\
#SRPM=%{SourceRPM}\n\
#MACHINE_ARCH=%{arch}\n\
#AUTOMATIC=%{autoinstalled}\n\
#[PROVIDES=%{provides}\n]\
#[REQUIRES=%{requires}\n]\
#[PLIST=%{filenames}\n]\

############################################################
usage (){
    cat 1>&2 <<EOF
rpmdb2summary - prints rpmdb(8) content in pkg_summary(5) format

usage:
  rpmdb2summary [OPTIONS] [packages ...]
OPTIONS:
  -h            display this help message
  -A            print summary for all installed packages
  -a            print summary for auto-installed packages
  -u            print summary for user-installed packages
  -f <fmt>      format of summary in rpm --qf format
  -r            use field names from rpm -qi
  -p            Use package file names instead of rpmdb
EOF
}

while getopts aAf:hpru f; do
    case "$f" in
	a)    auto_installed=1;;
	A)    rpm_opts="$rpm_opts -a";;
	f)    summary_format="$OPTARG";;
	h)    usage; exit 0;;
	p)    rpm_opts="$rpm_opts -p";;
	r)    summary_format="$rpm_format";;
	u)    user_installed=1;;
	?)    printf "Run rpmdb2summary -h for details\n"; exit 2;;
    esac
done
shift `expr $OPTIND - 1`

run_rpm() {
    if test -n "$auto_installed"; then
	runpipe0 rpm -qa --qf '%{autoinstalled} %{nevr}\n' '|' \
	    sed -n 's/^1 //p' '|' \
	    xargs rpm -q $rpm_opts --qf "$summary_format\n" "$@"
    elif test -n "$user_installed"; then
	runpipe0 rpm -qa --qf '%{autoinstalled} %{nevr}\n' '|' \
	    sed -n 's/^0 //p' '|' \
	    xargs rpm -q $rpm_opts --qf "$summary_format\n" "$@"
    elif test -n "$rpm_opts" -o $# -gt 0; then
	rpm -q $rpm_opts --qf "$summary_format\n" "$@"
    fi
}

fix_DESCRIPTION(){
    runawk -F= -e '
#use "alt_assert.awk"

/^[A-Z_a-z]+=/ {
    field = $1
    print $0
    next
}
NF == 0 {
    print $0
    field = ""
    next
}
{
    print field "=" $0
    next
}
' "$@"
}

runpipe0 run_rpm "$@" '|' fix_DESCRIPTION
