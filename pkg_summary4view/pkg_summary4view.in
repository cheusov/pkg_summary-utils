############################################################

#env "LC_ALL=C"

#use "alt_getopt.awk"
#use "abort.awk"
#use "power_getopt.awk"
#use "heapsort.awk"
#use "trim.awk"

############################################################
#.begin-str help
# pkg_summary4view - converts pkg_summary(5) to human readable format
# usage: pkg_summary4view [OPTIONS] [files...]
# OPTIONS:
#   -h       display this help
#.end-str
############################################################

function repeat (c, n,            ret){
	ret = ""
	while (n-- > 0) ret = ret c
	return ret
}

function resort_D0 (arr, remap,                i){
	for (i=1; i <= NF; ++i){
		arr [i] = $i
	}
	heapsort(arr, remap, 1, NF)
	for (i=1; i <= NF; ++i){
		$i = arr [remap [i]]
	}
}

BEGIN {
	indent_size = 4
	indent = repeat(" ", indent_size)

	if (getarg("h")){
		print_help()
		exitnow(0)
	}

	split_["TARGET_BUILD_DEPENDS"] = split_["_ALL_DEPENDS"] = split_["BUILD_DEPENDS"] = \
		split_["DEPENDS"] = split_["TOOL_DEPENDS"] = split_["CONFLICTS"] = 1

	prev_line = ""
	prev_field = ""
	prev_offset = 0

	FS = "="
}

function trim_clr (s, repl){
	if (repl == "")
		repl = " "

	sub(/[ \t]+$/, "", s)
	sub(/^[ \t]+/, "", s)
	gsub(/[ \t]+/, repl, s)
	return s
}

function print_prev(sep) {
	if (prev_offset > 0){
		print repeat(" ", prev_offset) prev_line
	} else if (NR == 1) {
	} else if (prev_field == "") {
		print ""
	} else if (prev_field in split_) {
		tokens_str = trim_clr(prev_line)
		tokens_cnt = split(tokens_str, tokens, / /)
		heapsort(tokens, remap, 1, tokens_cnt)
		out = indent trim_clr(prev_line, "\n" indent)
		printf "%-15s\n", prev_field ":"
		for (i=1; i <= tokens_cnt; ++i) {
			print indent tokens[remap[i]]
		}
		delete tokens
	} else if (!sep) {
		printf "%-15s %s\n", prev_field ":", prev_line
	} else {
		printf "%-15s\n%s\n", prev_field ":", indent prev_line
	}
}

{
	if ($1 != prev_field) {
		print_prev()
		prev_offset = 0
	} else {
		print_prev(1)
		prev_offset = indent_size
	}

	if (NF > 0 && prev_field == "") {
		print "------------------------------------------------------------"
	}

	prev_line = $0
	sub(/^[^=]*=/, "", prev_line)
	prev_field = $1
}

END {
	if (NR > 0)
		print_prev()
}
